:root{
  --bg:#EEF1F8;
  --surface:#ffffff;
  --surface2:#F5F7FC;
  --ink:#17203A;
  --muted:#5B6685;
  --line:#E2E7F2;
  --blue:#1D4ED8;
  --blue-soft:#EAF0FF;
  --violet:#6D28D9;
  --orange:#EA580C;
  --green:#15803D;
  --green-soft:#E7F9F2;
  --pink:#DB2777;
  --red:#B91C1C;
  --amber:#92400E;
  --safe-area-inset-top:0px;
  --radius:18px;
  --radius-sm:12px;
  --shadow:0 10px 28px rgba(23,32,58,.07);
  --shadow-lg:0 24px 60px rgba(15,23,42,.22);
}

@media (prefers-color-scheme: dark){
  :root{
    --bg:#0F172A;
    --surface:#1E293B;
    --surface2:#243349;
    --ink:#F1F5F9;
    --muted:#B6C0D4;
    --line:#334155;
    --blue:#60A5FA;
    --blue-soft:#1E3A5F;
    --violet:#A78BFA;
    --orange:#FB923C;
    --green:#4ADE80;
    --green-soft:#14532D;
    --pink:#F472B6;
    --red:#FCA5A5;
    --amber:#FBBF24;
    --shadow:0 10px 28px rgba(0,0,0,.35);
    --shadow-lg:0 24px 60px rgba(0,0,0,.5);
  }
}

*{
  box-sizing:border-box
}

html{
  direction:rtl
}

body{
  margin:0;
  background:var(--bg);
  color:var(--ink);
  font-family:"Cairo","IBM Plex Sans Arabic",system-ui,sans-serif;
  line-height:1.65
}

h2{
  font-size:clamp(20px,3vw,26px);
  line-height:1.35;
  letter-spacing:-.01em
}

h3{
  font-size:18px;
  line-height:1.4
}

.print-sheet{
  background:#fff;
  color:#17203A;
  border:1px solid #D9DEEB;
  border-radius:var(--radius-sm);
  padding:28px 30px;
  box-shadow:0 4px 18px rgba(0,0,0,.06);
  font-family:"Cairo","IBM Plex Sans Arabic",system-ui,sans-serif
}

.print-sheet h3,.print-sheet h2{
  margin:6px 0 12px
}

@media print{
  body{
    background:#fff
  }

  .modal{
    position:static;
    background:#fff;
    padding:0
  }

  .print-sheet{
    border:0;
    box-shadow:none;
    padding:0
  }
}

input,select,textarea,button{
  font-family:inherit
}

input,select,textarea{
  border:1px solid var(--line);
  border-radius:10px;
  padding:10px 12px;
  background:var(--surface);
  color:var(--ink);
  width:100%;
  outline:none;
  transition:border-color .15s,box-shadow .15s
}

input:focus,select:focus,textarea:focus{
  border-color:var(--blue);
  box-shadow:0 0 0 3px rgba(37,99,235,.18)
}

button{
  cursor:pointer;
  border:0;
  transition:transform .12s,box-shadow .15s,background .15s,filter .15s
}

button:hover{
  filter:brightness(.97)
}

button:active{
  transform:translateY(1px)
}

button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{
  outline:3px solid var(--blue);
  outline-offset:2px
}

button:disabled{
  opacity:.55;
  cursor:not-allowed;
  transform:none
}

.card{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  padding:18px
}

.chip{
  border-radius:999px;
  padding:5px 11px;
  font-size:12px;
  font-weight:800;
  display:inline-flex;
  align-items:center;
  gap:5px;
  border:1px solid transparent
}

.btn{
  border-radius:11px;
  padding:10px 15px;
  font-weight:800;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  box-shadow:0 2px 8px rgba(15,23,42,.06)
}

.btn-primary{
  background:var(--blue);
  color:#fff
}

.btn-primary:hover{
  background:#1E40AF
}

.btn-violet{
  background:var(--violet);
  color:#fff
}

.btn-orange{
  background:var(--orange);
  color:#fff
}

.btn-green{
  background:var(--green);
  color:#fff
}

.btn-ghost{
  background:#EEF1F8;
  color:#263151
}

.btn-outline{
  border:1px solid var(--line);
  background:var(--surface);
  color:var(--ink)
}

@media (prefers-color-scheme: dark){
  .btn-ghost{
    background:#334155;
    color:#F1F5F9
  }

  .card{
    border-color:var(--line)
  }
}

.navbtn{
  width:100%;
  display:flex;
  align-items:center;
  gap:10px;
  padding:11px 12px;
  border-radius:12px;
  background:transparent;
  color:#5B6685;
  font-weight:700
}

.navbtn.active{
  background:#EAF0FF;
  color:var(--blue)
}

.small{
  font-size:12px;
  color:var(--muted)
}

.num{
  font-variant-numeric:tabular-nums;
  direction:ltr;
  display:inline-block
}

table{
  width:100%;
  border-collapse:collapse;
  font-size:13px
}

th{
  text-align:right;
  padding:12px;
  background:#F1F4FB;
  color:#3D4868;
  font-weight:800;
  border-bottom:2px solid var(--line)
}

td{
  padding:11px 12px;
  border-top:1px solid #EEF1F8;
  vertical-align:top
}

tbody tr:nth-child(even){
  background:rgba(245,247,252,.55)
}

th,td{
  overflow-wrap:anywhere
}

@media (prefers-color-scheme: dark){
  th{
    background:#243349;
    color:#E2E8F0
  }

  td{
    border-top-color:#334155
  }

  tbody tr:nth-child(even){
    background:rgba(51,65,85,.28)
  }
}

.modal{
  position:fixed;
  inset:0;
  overflow-y:auto;
  background:rgba(10,18,40,.52);
  z-index:50;
  padding-top:max(1rem,var(--safe-area-inset-top));
  padding-bottom:1rem
}

.modal .card{
  border-radius:20px;
  box-shadow:var(--shadow-lg)
}

.flow-node{
  cursor:pointer;
  transition:.15s
}

.flow-node:hover{
  transform:translateY(-3px)
}

::-webkit-scrollbar{
  height:8px;
  width:8px
}

::-webkit-scrollbar-thumb{
  background:#C7CFE3;
  border-radius:99px
}

/* Toast موحّد أسفل اليسار */

.toast-wrap{
  position:fixed;
  left:16px;
  bottom:16px;
  z-index:120;
  display:flex;
  flex-direction:column;
  gap:10px;
  max-width:min(420px,calc(100vw - 32px))
}

.toast{
  display:flex;
  gap:10px;
  align-items:flex-start;
  background:var(--surface);
  color:var(--ink);
  border:1px solid var(--line);
  border-inline-start:5px solid var(--blue);
  border-radius:14px;
  box-shadow:var(--shadow-lg);
  padding:12px 14px;
  font-size:14px;
  line-height:1.6;
  overflow-wrap:anywhere;
  animation:toastIn .18s ease-out
}

.toast-success{
  border-inline-start-color:#16A34A
}

.toast-error{
  border-inline-start-color:#DC2626
}

.toast-warning{
  border-inline-start-color:#F59E0B
}

/* Skeleton */

.skeleton{
  border-radius:12px;
  background:linear-gradient(90deg,#E8ECF5 25%,#F5F7FC 50%,#E8ECF5 75%);
  background-size:200% 100%;
  animation:skeletonPulse 1.3s infinite;
  min-height:18px
}

@keyframes skeletonPulse{
  0%{
    background-position:200% 0
  }

  100%{
    background-position:-200% 0
  }
}

@keyframes toastIn{
  from{
    opacity:0;
    transform:translateY(8px)
  }

  to{
    opacity:1;
    transform:none
  }
}

/* درج الموبايل المنزلق */

.drawer-backdrop{
  position:fixed;
  inset:0;
  background:rgba(10,18,40,.55);
  z-index:60;
  animation:toastIn .18s ease-out
}

.drawer-panel{
  position:fixed;
  top:0;
  bottom:0;
  right:0;
  width:min(300px,86vw);
  background:#23232F;
  padding:18px;
  z-index:61;
  overflow-y:auto;
  box-shadow:var(--shadow-lg);
  transform:translateX(0);
  transition:transform .22s ease-out;
  padding-top:max(18px,var(--safe-area-inset-top))
}

.empty-state{
  text-align:center;
  padding:28px 16px;
  border:1px dashed var(--line);
  border-radius:var(--radius);
  background:var(--surface2)
}

@media(max-width:760px){
  .hide-m{
    display:none
  }

  .toast-wrap{
    left:12px;
    right:12px;
    max-width:none
  }
}
</style>
